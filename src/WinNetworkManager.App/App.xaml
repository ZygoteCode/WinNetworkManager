<Application x:Class="WinNetworkManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- ThemeManager inserts the colour palette at index 0 before the first window is created. -->
        <ResourceDictionary Source="pack://application:,,,/WinNetworkManager.UI;component/Themes/DesignSystem.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
