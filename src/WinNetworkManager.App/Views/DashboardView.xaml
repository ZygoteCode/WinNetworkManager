<UserControl x:Class="WinNetworkManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
             xmlns:controls="clr-namespace:WinNetworkManager.UI.Controls;assembly=WinNetworkManager.UI"
             xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignWidth="1100" d:DesignHeight="800">
  <UserControl.Resources>
    <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}" />
    <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="KeyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="{DynamicResource Pad.Page}">
      <TextBlock Text="Dashboard" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
      <TextBlock Text="Live view of your network adapters, the applications using them and the connection state." Style="{StaticResource Text.Secondary}" Margin="0,0,0,16" />

      <!-- Collector banner -->
      <Border Margin="0,0,0,16" Visibility="{Binding ShowCollectorBanner, Converter={StaticResource BoolToVisibility}}">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource InfoBar}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding CollectorBannerIsError}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.DangerBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Danger}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:IconText Style="{StaticResource Icon}" Text="{x:Static ui:Glyphs.Shield}" FontSize="{DynamicResource FontSize.IconLarge}" VerticalAlignment="Top" Margin="0,2,12,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding CollectorBannerTitle}" Style="{StaticResource Text.BodyStrong}" />
            <TextBlock Text="{Binding CollectorBannerText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
            <TextBlock Text="{Binding DataContext.CollectorMessage, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding DataContext.CollectorMessage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Button.Accent}" ui:Ui.Icon="{x:Static ui:Glyphs.Shield}" Content="Enable per-process monitoring" Margin="16,0,0,0" VerticalAlignment="Center"
                  Command="{Binding EnableCollectorCommand}" Visibility="{Binding CollectorBannerHasAction, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Starts the elevated collector helper (one administrator permission prompt). The main window stays unprivileged." />
        </Grid>
      </Border>

      <!-- Metric tiles -->
      <UniformGrid Columns="5" Margin="-6,0,-6,16">
        <Border Style="{StaticResource Card}" Margin="6" AutomationProperties.Name="Download, all adapters">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <controls:IconText Style="{StaticResource Icon}" Text="{x:Static ui:Glyphs.Download}" Foreground="{DynamicResource Brush.Data.Download}" FontSize="{DynamicResource FontSize.IconSmall}" Margin="0,0,6,6" />
              <TextBlock Text="DOWNLOAD · ADAPTERS" Style="{StaticResource TileLabel}" />
            </StackPanel>
            <TextBlock Text="{Binding DownloadRate}" Style="{StaticResource TileValue}" />
            <TextBlock Text="{Binding DownloadTotal}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
            <controls:Sparkline Values="{Binding DownloadSpark}" Height="28" Stroke="{DynamicResource Brush.Data.Download}" Fill="{DynamicResource Brush.Data.DownloadFill}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6" AutomationProperties.Name="Upload, all adapters">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <controls:IconText Style="{StaticResource Icon}" Text="{x:Static ui:Glyphs.Upload}" Foreground="{DynamicResource Brush.Data.Upload}" FontSize="{DynamicResource FontSize.IconSmall}" Margin="0,0,6,6" />
              <TextBlock Text="UPLOAD · ADAPTERS" Style="{StaticResource TileLabel}" />
            </StackPanel>
            <TextBlock Text="{Binding UploadRate}" Style="{StaticResource TileValue}" />
            <TextBlock Text="{Binding UploadTotal}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
            <controls:Sparkline Values="{Binding UploadSpark}" Height="28" Stroke="{DynamicResource Brush.Data.Upload}" Fill="{DynamicResource Brush.Data.UploadFill}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6" AutomationProperties.Name="Traffic attributed to applications">
          <StackPanel>
            <TextBlock Text="ATTRIBUTED TO APPS" Style="{StaticResource TileLabel}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Typography.NumeralAlignment="Tabular">
              <Run Text="↓" Foreground="{DynamicResource Brush.Data.Download}" /><Run Text=" " /><Run Text="{Binding AttributedDown, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Subtitle}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0">
              <Run Text="↑" Foreground="{DynamicResource Brush.Data.Upload}" /><Run Text=" " /><Run Text="{Binding AttributedUp, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding AttributedCaption}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6" AutomationProperties.Name="Applications using the network">
          <StackPanel>
            <TextBlock Text="ACTIVE APPS" Style="{StaticResource TileLabel}" />
            <TextBlock Text="{Binding ActiveApps}" Style="{StaticResource TileValue}" />
            <TextBlock Text="{Binding ActiveAppsCaption}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6" AutomationProperties.Name="Connections">
          <StackPanel>
            <TextBlock Text="CONNECTIONS" Style="{StaticResource TileLabel}" />
            <TextBlock Text="{Binding TcpConnections}" Style="{StaticResource TileValue}" />
            <TextBlock Text="{Binding ConnectionsCaption}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Chart + top apps -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Throughput · last 60 seconds" Style="{StaticResource Text.BodyStrong}" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Adapters: everything on physical interfaces, headers included. Apps: TCP/UDP payload attributed to processes." />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="Show apps" IsChecked="{Binding ShowAttributedSeries}" VerticalAlignment="Top" />
            </Grid>
            <controls:TimeSeriesChart Height="240" Series="{Binding ThroughputSeries}" Title="Network throughput, last 60 seconds" Units="{Binding Units}" />
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Top applications now" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,10" />
            <TextBlock DockPanel.Dock="Bottom" Text="No application is transferring data right now." Margin="0,8,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TopProcesses.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TopProcessItem}">
                  <Button Style="{StaticResource Button.Subtle}" Padding="6,4" Margin="0,0,0,2" HorizontalContentAlignment="Stretch"
                          Command="{Binding DataContext.OpenProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding AccessibleName}" ToolTip="Open process details">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Grid.RowSpan="2" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Primary}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Down}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Data.Download}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Up}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Data.Upload}" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular" />
                      </StackPanel>
                      <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Share, Mode=OneWay}" Height="3" Margin="0,5,0,0" Focusable="False" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Network + breakdown -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <controls:IconText Style="{StaticResource Icon}" Text="{Binding ConnectivityGlyph}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding ConnectivityText}" Style="{StaticResource Text.BodyStrong}" />
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Interface" Style="{StaticResource KeyText}" />
              <TextBlock Grid.Column="1" Text="{Binding InterfaceName}" Style="{StaticResource ValueText}" />
              <TextBlock Grid.Row="1" Text="Adapter" Style="{StaticResource KeyText}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InterfaceDetail}" Style="{StaticResource ValueText}" Foreground="{DynamicResource Brush.Text.Secondary}" />
              <TextBlock Grid.Row="2" Text="IPv4" Style="{StaticResource KeyText}" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IPv4Addresses, Mode=OneWay}" Style="{StaticResource TextBox.Value}" Margin="0,0,0,6" AutomationProperties.Name="IPv4 addresses" />
              <TextBlock Grid.Row="3" Text="IPv6" Style="{StaticResource KeyText}" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IPv6Addresses, Mode=OneWay}" Style="{StaticResource TextBox.Value}" Margin="0,0,0,6" AutomationProperties.Name="IPv6 addresses" />
              <TextBlock Grid.Row="4" Text="Gateway" Style="{StaticResource KeyText}" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Gateways, Mode=OneWay}" Style="{StaticResource TextBox.Value}" Margin="0,0,0,6" AutomationProperties.Name="Default gateway" />
              <TextBlock Grid.Row="5" Text="DNS servers" Style="{StaticResource KeyText}" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DnsServers, Mode=OneWay}" Style="{StaticResource TextBox.Value}" AutomationProperties.Name="DNS servers" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Where the bytes are counted · this session" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Physical adapters" Style="{StaticResource KeyText}" ToolTip="Link-layer octets on hardware adapters: all protocols, including IP/TCP/UDP headers, ICMP, ARP, DHCP and VPN encapsulation." />
              <TextBlock Grid.Column="1" Text="{Binding PhysicalSession}" Style="{StaticResource ValueText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Grid.Row="1" Text="Attributed to apps" Style="{StaticResource KeyText}" ToolTip="TCP and UDP payload attributed to a process by kernel event tracing, excluding loopback." />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AttributedSession}" Style="{StaticResource ValueText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Grid.Row="2" Text="TCP / UDP" Style="{StaticResource KeyText}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TcpUdpSplit}" Style="{StaticResource ValueText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Grid.Row="3" Text="Loopback (local)" Style="{StaticResource KeyText}" ToolTip="Traffic between processes on this computer. It never touches a network adapter and is excluded from network totals by default." />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LoopbackSession}" Style="{StaticResource ValueText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Grid.Row="4" Text="Not attributable" Style="{StaticResource KeyText}" ToolTip="Approximate difference between adapters and attributed traffic: protocol headers, non-TCP/UDP protocols, kernel traffic, and traffic before monitoring started." />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnattributedSession}" Style="{StaticResource ValueText}" Typography.NumeralAlignment="Tabular" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="These figures come from different sources and are never added together. Hover a label for details." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
