<UserControl x:Class="WinNetworkManager.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
             xmlns:common="clr-namespace:WinNetworkManager.App.Common"
             xmlns:controls="clr-namespace:WinNetworkManager.UI.Controls;assembly=WinNetworkManager.UI"
             xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </UserControl.InputBindings>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="{DynamicResource Pad.Page}">
      <!-- Header -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="History" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding RangeSummary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="Refresh" ui:Ui.Icon="{x:Static ui:Glyphs.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="Reload the selected range (F5)" />
          <Button Content="Export CSV" ui:Ui.Icon="{x:Static ui:Glyphs.Export}" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,8,0" />
          <Button Content="Export JSON" Command="{Binding ExportCommand}" CommandParameter="json" />
        </StackPanel>
      </Grid>

      <!-- Range selection -->
      <WrapPanel Margin="0,0,0,12">
        <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,6">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" Content="60 s" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Minute}" AutomationProperties.Name="Last 60 seconds" />
            <RadioButton Style="{StaticResource Segment}" Content="5 min" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=FiveMinutes}" AutomationProperties.Name="Last 5 minutes" />
            <RadioButton Style="{StaticResource Segment}" Content="15 min" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=FifteenMinutes}" AutomationProperties.Name="Last 15 minutes" />
            <RadioButton Style="{StaticResource Segment}" Content="1 h" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Hour}" AutomationProperties.Name="Last hour" />
            <RadioButton Style="{StaticResource Segment}" Content="24 h" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Day}" AutomationProperties.Name="Last 24 hours" />
            <RadioButton Style="{StaticResource Segment}" Content="7 days" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Week}" AutomationProperties.Name="Last 7 days" />
            <RadioButton Style="{StaticResource Segment}" Content="30 days" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Month}" AutomationProperties.Name="Last 30 days" />
            <RadioButton Style="{StaticResource Segment}" Content="Custom" GroupName="HistoryRange" IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Custom}" AutomationProperties.Name="Custom range" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding Range, Converter={x:Static common:EnumVisibility.Instance}, ConverterParameter=Custom}">
          <TextBlock Text="From" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Text="{Binding CustomFrom, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Custom range start" ToolTip="Local date and time, e.g. 2026-11-21 08:00">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ApplyCustomCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Text="to" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,6,0" />
          <TextBox Text="{Binding CustomTo, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Custom range end" ToolTip="Local date and time">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ApplyCustomCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Content="Show" Style="{StaticResource Button.Accent}" Command="{Binding ApplyCustomCommand}" Margin="8,0,0,0" />
        </StackPanel>
      </WrapPanel>

      <!-- Notice -->
      <Border Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{StaticResource Icon}" Text="{x:Static ui:Glyphs.Info}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" MaxWidth="960" />
        </StackPanel>
      </Border>

      <!-- Totals -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Text.BodyStrong}" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CoverageText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- System charts -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="Throughput" Style="{StaticResource Text.BodyStrong}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Text="Adapters: link-layer octets on physical interfaces (all protocols, headers included). Apps: TCP/UDP payload attributed to processes. Gaps mean “not measured”." />
            </StackPanel>
            <controls:TimeSeriesChart Height="240" Series="{Binding ThroughputSeries}" StartTime="{Binding ChartStart}" Step="{Binding ChartStep}"
                                      RelativeTime="{Binding RelativeTime}" Units="{Binding Units}" Title="Throughput in the selected range" />
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="TCP vs UDP" Style="{StaticResource Text.BodyStrong}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Attributed payload, both directions, stacked." />
            </StackPanel>
            <controls:TimeSeriesChart Height="240" Series="{Binding ProtocolSeries}" StartTime="{Binding ChartStart}" Step="{Binding ChartStep}" Stacked="True"
                                      RelativeTime="{Binding RelativeTime}" Units="{Binding Units}" Title="TCP and UDP traffic in the selected range" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- Applications -->
      <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="Applications in this range" Style="{StaticResource Text.BodyStrong}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Grouped by executable, per-minute data. Select an application to chart it." />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="No per-application data in this range." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                       Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <DataGrid ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" MaxHeight="320" MinHeight="120" AutomationProperties.Name="Applications in the selected range" CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="↓ Received" Binding="{Binding DownText}" SortMemberPath="Received" Width="100" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
                <DataGridTextColumn Header="↑ Sent" Binding="{Binding UpText}" SortMemberPath="Sent" Width="100" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" SortMemberPath="Total" Width="100" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
                <DataGridTextColumn Header="TCP" Binding="{Binding TcpText}" SortMemberPath="TcpBytes" Width="90" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
                <DataGridTextColumn Header="UDP" Binding="{Binding UdpText}" SortMemberPath="UdpBytes" Width="90" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
              </DataGrid.Columns>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                  <Setter Property="ToolTip" Value="{Binding Path}" />
                </Style>
              </DataGrid.RowStyle>
            </DataGrid>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource Text.BodyStrong}">
                <Run Text="Selected application: " /><Run Text="{Binding SelectedApp.Name, Mode=OneWay, FallbackValue=none}" />
              </TextBlock>
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Average rate per minute." />
            </StackPanel>
            <controls:TimeSeriesChart Height="220" Series="{Binding AppSeries}" StartTime="{Binding MinuteChartStart}" Step="{Binding MinuteChartStep}"
                                      RelativeTime="False" Units="{Binding Units}" Title="Traffic of the selected application" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- Interface -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Per interface" Style="{StaticResource Text.BodyStrong}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Link-layer octets of one physical adapter, average rate per minute." />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Name" MinWidth="220"
                      VerticalAlignment="Top" AutomationProperties.Name="Interface to chart" />
          </Grid>
          <controls:TimeSeriesChart Height="220" Series="{Binding InterfaceSeries}" StartTime="{Binding MinuteChartStart}" Step="{Binding MinuteChartStep}"
                                    RelativeTime="False" Units="{Binding Units}" Title="Traffic of the selected interface" />
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
