<UserControl x:Class="WinNetworkManager.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
             xmlns:common="clr-namespace:WinNetworkManager.App.Common"
             xmlns:controls="clr-namespace:WinNetworkManager.UI.Controls;assembly=WinNetworkManager.UI"
             xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProcessesViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{x:Static common:FocusCommands.FocusSearch}" />
  </UserControl.InputBindings>

  <DockPanel Margin="{DynamicResource Pad.Page}">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Processes" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="Export CSV" ui:Ui.Icon="{x:Static ui:Glyphs.Export}" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,8,0"
                ToolTip="Export the rows shown, with raw values, units and data sources" />
        <Button Content="Export JSON" Command="{Binding ExportCommand}" CommandParameter="json" ToolTip="Export the rows shown as JSON" />
      </StackPanel>
    </Grid>

    <!-- Toolbar -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="520" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
               ui:Ui.Placeholder="Search name, path, publisher, PID — or filters like rate>1MB pid=4 -system:yes"
               AutomationProperties.Name="Search processes" AutomationProperties.HelpText="Free text or filters: name: path: publisher: user: pid= state: system:yes rate&gt;1MB down&gt; up&gt; total&gt; conn&gt;"
               ToolTip="Filters: name:, path:, publisher:, user:, state:, pid=, system:yes|no, rate&gt;1MB, down&gt;, up&gt;, total&gt;100MB, conn&gt;5. Prefix with - to exclude.">
        <TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
        <ToggleButton Content="Group by app" IsChecked="{Binding GroupByApplication}" Margin="0,0,6,0" ToolTip="Group instances of the same executable" />
        <ToggleButton Content="Hide system" IsChecked="{Binding HideSystem}" Margin="0,0,6,0" ToolTip="Hide kernel, session 0 and service-account processes" />
        <ToggleButton Content="Show idle" IsChecked="{Binding ShowIdle}" ToolTip="Include processes that never used the network" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding ExportMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <!-- Collector notice -->
    <Border DockPanel.Dock="Top" Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="{Binding TrafficUnavailable, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                   Text="Traffic columns show “—” because per-process monitoring is off. Process list, sockets and connections work without it." />
        <Button Grid.Column="1" Style="{StaticResource Button.Accent}" Content="Enable" ui:Ui.Icon="{x:Static ui:Glyphs.Shield}" Margin="12,0,0,0"
                Command="{Binding DataContext.EnableCollectorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>
    </Border>

    <Border Style="{StaticResource Panel}">
      <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" common:TableBehavior.TableId="processes"
                AutomationProperties.Name="Processes" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsExited}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open details" InputGestureText="Enter" Command="{Binding OpenDetailsCommand}" />
            <MenuItem Header="Show connections" Command="{Binding ShowConnectionsCommand}" />
            <Separator />
            <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
            <MenuItem Header="Copy PID" Command="{Binding CopyPidCommand}" />
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
            <MenuItem Header="Copy row" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
            <Separator />
            <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}" />
            <MenuItem Header="Hide this process" Command="{Binding HideProcessCommand}" ToolTip="Adds the image name to Settings → Hidden processes" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Name" SortMemberPath="name" Width="260" MinWidth="140" ClipboardContentBinding="{Binding Name}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:ProcessRowBase}">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent, Converter={x:Static common:IndentConverter.Instance}}" ToolTip="{Binding PathText}">
                  <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" Margin="-4,0,4,0" Focusable="False"
                          Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                          Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Expand or collapse group">
                    <controls:IconText Style="{StaticResource Icon}" FontSize="10">
                      <controls:IconText.Text>
                        <Binding Path="IsExpanded" FallbackValue="&#xE76C;">
                          <Binding.Converter>
                            <common:BoolToTextConverter TrueText="&#xE70D;" FalseText="&#xE76C;" />
                          </Binding.Converter>
                        </Binding>
                      </controls:IconText.Text>
                    </controls:IconText>
                  </Button>
                  <controls:AppIcon Source="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Text}" />
                  <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,0" Visibility="{Binding IsExited, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="exited" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="PID" SortMemberPath="pid" Binding="{Binding PidText}" Width="90" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
          <DataGridTemplateColumn Header="↓ Download" SortMemberPath="down" Width="110" HeaderStyle="{StaticResource ColumnHeader.Right}" ClipboardContentBinding="{Binding DownText}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:ProcessRowBase}">
                <TextBlock Text="{Binding DownText}" Style="{StaticResource Cell.Numeric}" ToolTip="TCP + UDP payload received per second" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="↑ Upload" SortMemberPath="up" Width="110" HeaderStyle="{StaticResource ColumnHeader.Right}" ClipboardContentBinding="{Binding UpText}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:ProcessRowBase}">
                <TextBlock Text="{Binding UpText}" Style="{StaticResource Cell.Numeric}" ToolTip="TCP + UDP payload sent per second" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Last 60 s" SortMemberPath="trend" CanUserSort="False" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:ProcessRowBase}">
                <controls:Sparkline Values="{Binding Trend}" Height="16" Stroke="{DynamicResource Brush.Data.Download}" Fill="{DynamicResource Brush.Data.DownloadFill}" ToolTip="Total traffic per second, last 60 seconds" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="TCP ↓" SortMemberPath="tcpDown" Binding="{Binding TcpDownText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="TCP ↑" SortMemberPath="tcpUp" Binding="{Binding TcpUpText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="UDP ↓" SortMemberPath="udpDown" Binding="{Binding UdpDownText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="UDP ↑" SortMemberPath="udpUp" Binding="{Binding UdpUpText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Total ↓" SortMemberPath="totalDown" Binding="{Binding TotalDownText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
          <DataGridTextColumn Header="Total ↑" SortMemberPath="totalUp" Binding="{Binding TotalUpText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
          <DataGridTextColumn Header="Total" SortMemberPath="total" Binding="{Binding TotalText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Avg ↓" SortMemberPath="avgDown" Binding="{Binding AvgDownText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Avg ↑" SortMemberPath="avgUp" Binding="{Binding AvgUpText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Peak ↓" SortMemberPath="peakDown" Binding="{Binding PeakDownText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Peak ↑" SortMemberPath="peakUp" Binding="{Binding PeakUpText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Sockets" SortMemberPath="conn" Binding="{Binding ConnectionsText}" Width="80" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
          <DataGridTextColumn Header="Remotes" SortMemberPath="remotes" Binding="{Binding RemotesText}" Width="85" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Retransmitted" SortMemberPath="retrans" Binding="{Binding RetransText}" Width="110" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Publisher" SortMemberPath="publisher" Binding="{Binding Publisher}" Width="170" ElementStyle="{StaticResource Cell.Secondary}" />
          <DataGridTextColumn Header="Description" SortMemberPath="description" Binding="{Binding Description}" Width="200" ElementStyle="{StaticResource Cell.Secondary}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Path" SortMemberPath="path" Binding="{Binding PathText}" Width="280" ElementStyle="{StaticResource Cell.Secondary}" Visibility="Collapsed" />
          <DataGridTextColumn Header="User" SortMemberPath="user" Binding="{Binding UserText}" Width="160" ElementStyle="{StaticResource Cell.Secondary}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Started" SortMemberPath="started" Binding="{Binding StartedText}" Width="140" ElementStyle="{StaticResource Cell.Secondary}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Monitored" SortMemberPath="monitored" Binding="{Binding MonitoredText}" Width="110" ElementStyle="{StaticResource Cell.Secondary}" Visibility="Collapsed" />
          <DataGridTextColumn Header="Status" SortMemberPath="status" Binding="{Binding StatusText}" Width="150" ElementStyle="{StaticResource Cell.Secondary}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
