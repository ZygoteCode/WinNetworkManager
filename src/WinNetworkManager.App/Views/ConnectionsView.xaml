<UserControl x:Class="WinNetworkManager.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
             xmlns:common="clr-namespace:WinNetworkManager.App.Common"
             xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ConnectionsViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{x:Static common:FocusCommands.FocusSearch}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <ContextMenu x:Key="TcpMenu">
      <MenuItem Header="Go to process" Command="{Binding GoToProcessCommand}" />
      <Separator />
      <MenuItem Header="Copy local address" Command="{Binding CopyLocalAddressCommand}" />
      <MenuItem Header="Copy local endpoint" Command="{Binding CopyLocalEndpointCommand}" />
      <MenuItem Header="Copy remote address" Command="{Binding CopyRemoteAddressCommand}" />
      <MenuItem Header="Copy remote endpoint" Command="{Binding CopyRemoteEndpointCommand}" />
      <MenuItem Header="Copy row" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
      <Separator />
      <MenuItem Header="Filter by this process" Command="{Binding FilterProcessCommand}" />
      <MenuItem Header="Filter by this remote address" Command="{Binding FilterRemoteCommand}" />
      <MenuItem Header="Filter by this port" Command="{Binding FilterPortCommand}" />
      <Separator />
      <MenuItem Header="Ping remote address" Command="{Binding DiagnoseCommand}" CommandParameter="ping" />
      <MenuItem Header="Traceroute to remote address" Command="{Binding DiagnoseCommand}" CommandParameter="traceroute" />
      <MenuItem Header="Test TCP connection to remote endpoint" Command="{Binding DiagnoseCommand}" CommandParameter="tcp" />
      <MenuItem Header="Reverse DNS lookup" Command="{Binding DiagnoseCommand}" CommandParameter="dns" />
    </ContextMenu>
    <ContextMenu x:Key="UdpMenu">
      <MenuItem Header="Go to process" Command="{Binding GoToProcessCommand}" />
      <Separator />
      <MenuItem Header="Copy local address" Command="{Binding CopyLocalAddressCommand}" />
      <MenuItem Header="Copy local endpoint" Command="{Binding CopyLocalEndpointCommand}" />
      <MenuItem Header="Copy row" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
      <Separator />
      <MenuItem Header="Filter by this process" Command="{Binding FilterProcessCommand}" />
      <MenuItem Header="Filter by this port" Command="{Binding FilterPortCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <DockPanel Margin="{DynamicResource Pad.Page}">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Connections" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="Export CSV" ui:Ui.Icon="{x:Static ui:Glyphs.Export}" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,8,0" />
        <Button Content="Export JSON" Command="{Binding ExportCommand}" CommandParameter="json" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MaxWidth="460" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" Content="TCP" GroupName="SocketTab"
                       IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Tcp}" AutomationProperties.Name="TCP connections" />
          <RadioButton Style="{StaticResource Segment}" Content="UDP" GroupName="SocketTab"
                       IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Udp}" AutomationProperties.Name="UDP endpoints" />
        </StackPanel>
      </Border>
      <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
               ui:Ui.Placeholder="Search process, address, port — or rip:1.1.1.1 port=443 state:established"
               AutomationProperties.Name="Search connections"
               ToolTip="Filters: pid=, process:, ip:, lip:, rip:, port=, lport=, rport=, state:, scope:public, host:, service:. Prefix with - to exclude.">
        <TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
        <ToggleButton Content="Listening" IsChecked="{Binding ShowListening}" Margin="0,0,6,0" ToolTip="Show listening sockets" />
        <ToggleButton Content="Closed" IsChecked="{Binding ShowClosed}" Margin="0,0,6,0" ToolTip="Show TIME_WAIT and recently closed connections" />
        <ToggleButton Content="Loopback" IsChecked="{Binding ShowLoopback}" Margin="0,0,6,0" ToolTip="Show connections between local processes" />
        <ToggleButton Content="Resolve names" IsChecked="{Binding ResolveNames}"
                      ToolTip="Reverse-resolve remote addresses in the background (generates DNS queries; results are cached)" />
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding ActionMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <!-- UDP peers detail -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="220">
      <Border.Visibility>
        <MultiBinding Converter="{x:Static common:UdpDetailVisibility.Instance}">
          <Binding Path="Tab" />
          <Binding Path="SelectedUdp" />
        </MultiBinding>
      </Border.Visibility>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,8">
          <Run Text="Observed peers of " /><Run Text="{Binding SelectedUdp.ProcessName, Mode=OneWay}" /><Run Text=" on port " /><Run Text="{Binding SelectedUdp.LocalPort, Mode=OneWay}" />
        </TextBlock>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="UDP is connectionless: these are the remote endpoints seen in datagrams while the collector was running (most recent first)." />
        <DataGrid ItemsSource="{Binding SelectedUdp.Peers}" AutomationProperties.Name="Observed UDP peers" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding Endpoint}" Width="240" ElementStyle="{StaticResource Cell.Mono}" />
            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" ElementStyle="{StaticResource Cell.Secondary}" />
            <DataGridTextColumn Header="↓ Received" Binding="{Binding Received}" Width="110" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↑ Sent" Binding="{Binding Sent}" Width="110" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Last datagram" Binding="{Binding LastSeen}" Width="*" ElementStyle="{StaticResource Cell.Secondary}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Grid>
      <!-- TCP -->
      <Border Style="{StaticResource Panel}" Visibility="{Binding Tab, Converter={x:Static common:EnumVisibility.Instance}, ConverterParameter=Tcp}">
        <DataGrid x:Name="TcpGrid" ItemsSource="{Binding TcpRows}" SelectedItem="{Binding SelectedTcp}" common:TableBehavior.TableId="tcp"
                  ContextMenu="{StaticResource TcpMenu}" AutomationProperties.Name="TCP connections" MouseDoubleClick="OnTcpDoubleClick">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                  <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Process" SortMemberPath="process" Width="200" ClipboardContentBinding="{Binding ProcessName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:TcpRow}">
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Cell.Text}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="PID" SortMemberPath="pid" Binding="{Binding PidText}" Width="70" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Local address" SortMemberPath="lip" Binding="{Binding LocalAddress}" Width="170" ElementStyle="{StaticResource Cell.Mono}" />
            <DataGridTextColumn Header="Port" SortMemberPath="lport" Binding="{Binding LocalPort}" Width="70" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Remote address" SortMemberPath="rip" Binding="{Binding RemoteAddress}" Width="200" ElementStyle="{StaticResource Cell.Mono}" />
            <DataGridTextColumn Header="Port" SortMemberPath="rport" Binding="{Binding RemotePort}" Width="70" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Remote host" SortMemberPath="host" Binding="{Binding RemoteHost}" Width="200" ElementStyle="{StaticResource Cell.Secondary}" />
            <DataGridTextColumn Header="Scope" SortMemberPath="scope" Binding="{Binding ScopeText}" Width="100" ElementStyle="{StaticResource Cell.Secondary}" />
            <DataGridTemplateColumn Header="State" SortMemberPath="state" Width="140" ClipboardContentBinding="{Binding StateText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:TcpRow}">
                  <TextBlock Text="{Binding StateText}" Style="{StaticResource Cell.Text}" ToolTip="{Binding StateDescription}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Age" SortMemberPath="age" Width="100" HeaderStyle="{StaticResource ColumnHeader.Right}" ClipboardContentBinding="{Binding AgeText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:TcpRow}">
                  <TextBlock Text="{Binding AgeText}" Style="{StaticResource Cell.Numeric}" ToolTip="{Binding AgeToolTip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="↓ Rate" SortMemberPath="down" Binding="{Binding DownRateText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↑ Rate" SortMemberPath="up" Binding="{Binding UpRateText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↓ Total" SortMemberPath="downTotal" Binding="{Binding DownTotalText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↑ Total" SortMemberPath="upTotal" Binding="{Binding UpTotalText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Retrans." SortMemberPath="retrans" Binding="{Binding RetransText}" Width="80" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" Visibility="Collapsed" />
            <DataGridTextColumn Header="Service" SortMemberPath="service" Binding="{Binding ServiceText}" Width="140" ElementStyle="{StaticResource Cell.Secondary}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- UDP -->
      <Border Style="{StaticResource Panel}" Visibility="{Binding Tab, Converter={x:Static common:EnumVisibility.Instance}, ConverterParameter=Udp}">
        <DataGrid x:Name="UdpGrid" ItemsSource="{Binding UdpRows}" SelectedItem="{Binding SelectedUdp}" common:TableBehavior.TableId="udp"
                  ContextMenu="{StaticResource UdpMenu}" AutomationProperties.Name="UDP endpoints">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                  <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Process" SortMemberPath="process" Width="220" ClipboardContentBinding="{Binding ProcessName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:UdpRow}">
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Cell.Text}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="PID" SortMemberPath="pid" Binding="{Binding PidText}" Width="70" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Local address" SortMemberPath="lip" Binding="{Binding LocalAddress}" Width="200" ElementStyle="{StaticResource Cell.Mono}" />
            <DataGridTextColumn Header="Port" SortMemberPath="lport" Binding="{Binding LocalPort}" Width="70" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Observed peers" SortMemberPath="peers" Binding="{Binding PeersText}" Width="150" ElementStyle="{StaticResource Cell.Secondary}" />
            <DataGridTextColumn Header="↓ Rate" SortMemberPath="down" Binding="{Binding DownRateText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↑ Rate" SortMemberPath="up" Binding="{Binding UpRateText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↓ Total" SortMemberPath="downTotal" Binding="{Binding DownTotalText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="↑ Total" SortMemberPath="upTotal" Binding="{Binding UpTotalText}" Width="95" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Age" SortMemberPath="age" Binding="{Binding AgeText}" Width="100" ElementStyle="{StaticResource Cell.Numeric}" HeaderStyle="{StaticResource ColumnHeader.Right}" />
            <DataGridTextColumn Header="Service" SortMemberPath="service" Binding="{Binding ServiceText}" Width="140" ElementStyle="{StaticResource Cell.Secondary}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
