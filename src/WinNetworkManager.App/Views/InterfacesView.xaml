<UserControl x:Class="WinNetworkManager.App.Views.InterfacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
             xmlns:controls="clr-namespace:WinNetworkManager.UI.Controls;assembly=WinNetworkManager.UI"
             xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InterfacesViewModel}">
  <UserControl.Resources>
    <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <Style x:Key="Value" TargetType="TextBox" BasedOn="{StaticResource TextBox.Value}">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="{DynamicResource Pad.Page}">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Network interfaces" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <ToggleButton Content="Show all interfaces" IsChecked="{Binding ShowInactive}" Margin="0,0,8,0" ToolTip="Also show disconnected adapters, loopback and virtual interfaces without an IP address (WAN miniports, virtual switch ports)" />
        <Button Content="Copy details" ui:Ui.Icon="{x:Static ui:Glyphs.Copy}" Command="{Binding CopyDetailsCommand}" />
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Interfaces" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:InterfaceItem}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:IconText Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="{DynamicResource FontSize.IconLarge}" VerticalAlignment="Top" Margin="0,2,12,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" />
                <TextBlock Style="{StaticResource Text.Caption}">
                  <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TypeName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding PrimaryAddress}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding RateText}" Style="{StaticResource Text.Caption}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,6" />
                <controls:Sparkline Values="{Binding Spark}" Height="18" Stroke="{DynamicResource Brush.Data.Download}" />
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding DefaultText}" FontSize="{DynamicResource FontSize.Caption}" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding Selected}">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" />
              <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,12" TextWrapping="Wrap" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="RECEIVING" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding DownRate}" Style="{StaticResource Text.Metric}" Foreground="{DynamicResource Brush.Data.Download}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="SENDING" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding UpRate}" Style="{StaticResource Text.Metric}" Foreground="{DynamicResource Brush.Data.Upload}" />
                </StackPanel>
              </Grid>
              <controls:TimeSeriesChart Height="200" Series="{Binding Series}" Title="Interface throughput, last 60 seconds"
                                        Units="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="Link-layer octets reported by the adapter: all protocols and headers, including traffic of virtual machines bridged to it." />
              <Border Style="{StaticResource InfoBar.Warning}" Margin="0,8,0,0" Visibility="{Binding CounterReset, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="The adapter counters were reset (disabled/re-enabled or driver reload). No rate is shown for that interval." TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Status" Style="{StaticResource Key}" />
              <TextBox Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="Status" />
              <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource Key}" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Kind, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="Type" />
              <TextBlock Grid.Row="2" Text="Link speed" Style="{StaticResource Key}" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LinkSpeed, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="Link speed" />
              <TextBlock Grid.Row="3" Text="MAC address" Style="{StaticResource Key}" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Mac, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="MAC address" />
              <TextBlock Grid.Row="4" Text="MTU" Style="{StaticResource Key}" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Mtu, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="MTU" />
              <TextBlock Grid.Row="5" Text="Addresses" Style="{StaticResource Key}" />
              <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Addresses}" Margin="0,0,0,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:AddressLine}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                      <TextBox Text="{Binding Address, Mode=OneWay}" Style="{StaticResource TextBox.Value}" FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="Address" />
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Row="6" Text="Gateway" Style="{StaticResource Key}" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Gateways, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="Gateway" />
              <TextBlock Grid.Row="7" Text="DNS servers" Style="{StaticResource Key}" />
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DnsServers, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="DNS servers" />
              <TextBlock Grid.Row="8" Text="DNS suffix" Style="{StaticResource Key}" />
              <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding DnsSuffix, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="DNS suffix" />
              <TextBlock Grid.Row="9" Text="DHCP" Style="{StaticResource Key}" />
              <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Dhcp, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="DHCP" />
              <TextBlock Grid.Row="10" Text="This session" Style="{StaticResource Key}" />
              <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SessionTotals, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="Traffic this session" />
              <TextBlock Grid.Row="11" Text="Errors" Style="{StaticResource Key}" />
              <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Errors, Mode=OneWay}" Style="{StaticResource Value}" AutomationProperties.Name="Errors" />
              <TextBlock Grid.Row="12" Text="Identifiers" Style="{StaticResource Key}" />
              <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding IndexText, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="Identifiers" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
