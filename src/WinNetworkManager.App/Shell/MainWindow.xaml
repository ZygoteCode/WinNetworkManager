<Window x:Class="WinNetworkManager.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:WinNetworkManager.App.Shell"
        xmlns:vm="clr-namespace:WinNetworkManager.App.ViewModels"
        xmlns:views="clr-namespace:WinNetworkManager.App.Views"
        xmlns:controls="clr-namespace:WinNetworkManager.UI.Controls;assembly=WinNetworkManager.UI"
        xmlns:ui="clr-namespace:WinNetworkManager.UI;assembly=WinNetworkManager.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:ShellViewModel}"
        Title="WinNetworkManager"
        Width="1320" Height="840" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/WinNetworkManager;component/Assets/AppIcon.ico"
        Background="{DynamicResource Brush.Bg.Window}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Text}"
        FontSize="{DynamicResource FontSize.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><views:ProcessesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}"><views:ConnectionsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InterfacesViewModel}"><views:InterfacesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessInspectorViewModel}"><views:ProcessInspectorView /></DataTemplate>

    <!-- Navigation rail item -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Inset}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Shortcut}" />
      <Setter Property="ToolTip" Value="{Binding Label}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="40" Margin="6,2" Background="Transparent">
              <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
              <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                <controls:IconText Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="{DynamicResource FontSize.IconLarge}" Width="22" />
                <TextBlock x:Name="Label" Text="{Binding Label}" Margin="14,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Bg.SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Bg.SurfacePressed}" />
                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ui:Ui.CornerRadius" Value="0" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="IsTabStop" Value="False" />
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Dashboard}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Processes}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Connections}" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Interfaces}" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Diagnostics}" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.History}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Settings}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePauseCommand}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
  </Window.InputBindings>

  <Border x:Name="RootBorder" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Title bar -->
      <Grid Grid.ColumnSpan="2" Background="{DynamicResource Brush.Bg.Chrome}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="{x:Static ui:Glyphs.Menu}" Command="{Binding ToggleNavCommand}"
                  WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Toggle navigation" ToolTip="Expand or collapse navigation" />
          <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="{x:Static ui:Glyphs.Back}" Command="{Binding GoBackCommand}" Margin="2,0,0,0"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                  WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Back" ToolTip="Back (Alt+Left)" />
          <Image Source="pack://application:,,,/WinNetworkManager;component/Assets/AppIcon-64.png" Width="18" Height="18" Margin="10,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="WinNetworkManager" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <!-- Collector state chip in the title bar -->
        <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="0,0,12,0" Padding="10,3" WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="{Binding PrivilegeText}" AutomationProperties.Name="{Binding CollectorText}" Focusable="False">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="CollectorDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.Text.Tertiary}" />
            <TextBlock Text="{Binding CollectorText}" Margin="8,0,0,0" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize" />
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>

      <!-- Navigation rail -->
      <Border x:Name="NavRail" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Brush.Bg.Chrome}" Width="220">
        <DockPanel>
          <ListBox DockPanel.Dock="Bottom" Style="{StaticResource NavList}" ItemsSource="{Binding FooterItems}" Margin="0,0,0,8"
                   SelectedItem="{Binding SelectedFooterNav, Mode=TwoWay}" AutomationProperties.Name="Settings navigation" />
          <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedMainNav, Mode=TwoWay}" Margin="0,8,0,0"
                   AutomationProperties.Name="Main navigation" />
        </DockPanel>
      </Border>

      <!-- Page host -->
      <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Bg.Layer}" CornerRadius="10,0,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,1,0,0">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" />
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Brush.Bg.Layer}" BorderBrush="{DynamicResource Brush.Border.Divider}" BorderThickness="1,1,0,0" Padding="16,0">
        <Grid Height="28">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding EventsText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding DataAgeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
          <TextBlock Grid.Column="3" Text="{Binding RefreshText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ToggleButton Grid.Column="4" IsChecked="{Binding IsPaused}" Padding="10,1" MinHeight="22" ui:Ui.Icon="{x:Static ui:Glyphs.Pause}"
                        AutomationProperties.Name="Pause display" ToolTip="Freeze the display (Ctrl+P). Monitoring continues in the background.">
            <TextBlock Text="Pause" FontSize="{DynamicResource FontSize.Caption}" />
          </ToggleButton>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
