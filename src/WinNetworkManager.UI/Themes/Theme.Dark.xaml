<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WinNetworkManager "Graphite" dark palette. Contrast of text on Surface: Primary 15.8:1, Secondary 8.1:1, Tertiary 4.6:1. -->
  <Color x:Key="Color.Bg.Window">#0E1014</Color>
  <SolidColorBrush x:Key="Brush.Bg.Window" Color="#0E1014" />
  <SolidColorBrush x:Key="Brush.Bg.Chrome" Color="#0B0D11" />
  <SolidColorBrush x:Key="Brush.Bg.Layer" Color="#14171D" />
  <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#1A1E26" />
  <SolidColorBrush x:Key="Brush.Bg.SurfaceHover" Color="#212631" />
  <SolidColorBrush x:Key="Brush.Bg.SurfacePressed" Color="#272D39" />
  <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="#20242D" />
  <SolidColorBrush x:Key="Brush.Bg.Input" Color="#11141A" />
  <SolidColorBrush x:Key="Brush.Bg.RowHover" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Brush.Bg.RowAlternate" Color="#05FFFFFF" />
  <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#99000000" />

  <SolidColorBrush x:Key="Brush.Border.Default" Color="#2A303B" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#20252E" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3B4252" />
  <SolidColorBrush x:Key="Brush.Border.Divider" Color="#1F242C" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E9ECF2" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6ADBB" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#7C8493" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#555C69" />
  <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#0E1014" />

  <!-- Data series: download/upload are blue/amber (safe for red-green colour deficiency) and are always paired
       with arrows, labels and dash patterns, never conveyed by colour alone. -->
  <Color x:Key="Color.Data.Download">#2EC4F0</Color>
  <Color x:Key="Color.Data.Upload">#FFA43A</Color>
  <Color x:Key="Color.Data.Tcp">#9B8AFB</Color>
  <Color x:Key="Color.Data.Udp">#34D3B4</Color>
  <Color x:Key="Color.Data.Loopback">#8A93A3</Color>
  <Color x:Key="Color.Data.Neutral">#5B6474</Color>
  <SolidColorBrush x:Key="Brush.Data.Download" Color="#2EC4F0" />
  <SolidColorBrush x:Key="Brush.Data.Upload" Color="#FFA43A" />
  <SolidColorBrush x:Key="Brush.Data.Tcp" Color="#9B8AFB" />
  <SolidColorBrush x:Key="Brush.Data.Udp" Color="#34D3B4" />
  <SolidColorBrush x:Key="Brush.Data.Loopback" Color="#8A93A3" />
  <SolidColorBrush x:Key="Brush.Data.Neutral" Color="#5B6474" />
  <SolidColorBrush x:Key="Brush.Data.DownloadFill" Color="#262EC4F0" />
  <SolidColorBrush x:Key="Brush.Data.UploadFill" Color="#1FFFA43A" />
  <SolidColorBrush x:Key="Brush.Chart.Grid" Color="#1E232C" />
  <SolidColorBrush x:Key="Brush.Chart.Axis" Color="#7C8493" />
  <SolidColorBrush x:Key="Brush.Chart.Crosshair" Color="#66E9ECF2" />

  <SolidColorBrush x:Key="Brush.Status.Success" Color="#3CCB7F" />
  <SolidColorBrush x:Key="Brush.Status.Warning" Color="#F5C04A" />
  <SolidColorBrush x:Key="Brush.Status.Danger" Color="#F26D6D" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#5AA9FF" />
  <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="#1A3CCB7F" />
  <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="#1FF5C04A" />
  <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="#1FF26D6D" />
  <SolidColorBrush x:Key="Brush.Status.InfoBg" Color="#1F5AA9FF" />

  <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#3A404D" />
  <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#4D5463" />
</ResourceDictionary>
