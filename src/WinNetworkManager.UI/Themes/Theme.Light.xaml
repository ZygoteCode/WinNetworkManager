<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WinNetworkManager "Paper" light palette. Contrast on Surface: Primary 17.2:1, Secondary 8.0:1, Tertiary 4.8:1. -->
  <Color x:Key="Color.Bg.Window">#F2F3F6</Color>
  <SolidColorBrush x:Key="Brush.Bg.Window" Color="#F2F3F6" />
  <SolidColorBrush x:Key="Brush.Bg.Chrome" Color="#EBEDF1" />
  <SolidColorBrush x:Key="Brush.Bg.Layer" Color="#F7F8FA" />
  <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Bg.SurfaceHover" Color="#F1F3F6" />
  <SolidColorBrush x:Key="Brush.Bg.SurfacePressed" Color="#E7EAEF" />
  <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Bg.Input" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Bg.RowHover" Color="#0A000000" />
  <SolidColorBrush x:Key="Brush.Bg.RowAlternate" Color="#05000000" />
  <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#66000000" />

  <SolidColorBrush x:Key="Brush.Border.Default" Color="#D9DCE2" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E6E8EC" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="#BFC4CD" />
  <SolidColorBrush x:Key="Brush.Border.Divider" Color="#E9EBEF" />
  <!-- Card edge: lighter at the top, darker at the bottom like a soft shadow, giving cards depth without effects. -->
  <LinearGradientBrush x:Key="Brush.Border.Card" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E8EAEE" Offset="0" />
    <GradientStop Color="#CDD2DA" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#151920" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#4A5261" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6A7281" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#A3A9B3" />
  <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#FFFFFF" />

  <Color x:Key="Color.Data.Download">#0A7FBF</Color>
  <Color x:Key="Color.Data.Upload">#C9630A</Color>
  <Color x:Key="Color.Data.Tcp">#6A57D1</Color>
  <Color x:Key="Color.Data.Udp">#0C9277</Color>
  <Color x:Key="Color.Data.Loopback">#6B7280</Color>
  <Color x:Key="Color.Data.Neutral">#9AA1AD</Color>
  <SolidColorBrush x:Key="Brush.Data.Download" Color="#0A7FBF" />
  <SolidColorBrush x:Key="Brush.Data.Upload" Color="#C9630A" />
  <SolidColorBrush x:Key="Brush.Data.Tcp" Color="#6A57D1" />
  <SolidColorBrush x:Key="Brush.Data.Udp" Color="#0C9277" />
  <SolidColorBrush x:Key="Brush.Data.Loopback" Color="#6B7280" />
  <SolidColorBrush x:Key="Brush.Data.Neutral" Color="#9AA1AD" />
  <!-- Area fills fade from the series colour at the peak to transparent at the baseline. -->
  <LinearGradientBrush x:Key="Brush.Data.DownloadFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#400A7FBF" Offset="0" />
    <GradientStop Color="#000A7FBF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Data.UploadFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#33C9630A" Offset="0" />
    <GradientStop Color="#00C9630A" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Chart.Grid" Color="#ECEEF2" />
  <SolidColorBrush x:Key="Brush.Chart.Axis" Color="#6A7281" />
  <SolidColorBrush x:Key="Brush.Chart.Crosshair" Color="#66151920" />

  <SolidColorBrush x:Key="Brush.Status.Success" Color="#16834A" />
  <SolidColorBrush x:Key="Brush.Status.Warning" Color="#A86A0F" />
  <SolidColorBrush x:Key="Brush.Status.Danger" Color="#C23434" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#1F5FD6" />
  <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="#1A16834A" />
  <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="#1FA86A0F" />
  <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="#1AC23434" />
  <SolidColorBrush x:Key="Brush.Status.InfoBg" Color="#1A1F5FD6" />

  <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#C3C7CF" />
  <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#A9AEB8" />
</ResourceDictionary>
