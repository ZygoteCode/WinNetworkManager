<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WinNetworkManager.UI.Converters">
  <!-- Entry point of the design system. The colour palette is inserted before this dictionary at runtime by
       ThemeManager (dark / light / high contrast); everything here references colours via DynamicResource. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/WinNetworkManager.UI;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/WinNetworkManager.UI;component/Themes/Controls.xaml" />
    <ResourceDictionary Source="pack://application:,,,/WinNetworkManager.UI;component/Themes/DataGrid.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:EqualsConverter x:Key="Equals" />
</ResourceDictionary>
