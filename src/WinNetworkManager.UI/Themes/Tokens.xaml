<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Typography. Sizes are DynamicResources: ThemeManager rescales them with the Windows text-size setting and the
       user's text scale, so every text in the app scales together. -->
  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">14</sys:Double>
  <sys:Double x:Key="FontSize.BodyLarge">15</sys:Double>
  <sys:Double x:Key="FontSize.Subtitle">18</sys:Double>
  <sys:Double x:Key="FontSize.Title">24</sys:Double>
  <sys:Double x:Key="FontSize.Metric">28</sys:Double>
  <sys:Double x:Key="FontSize.Display">34</sys:Double>
  <sys:Double x:Key="FontSize.Icon">16</sys:Double>
  <sys:Double x:Key="FontSize.IconSmall">12</sys:Double>
  <sys:Double x:Key="FontSize.IconLarge">20</sys:Double>

  <!-- Geometry (4 px grid). -->
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
  <Thickness x:Key="Pad.Control">10,5,10,5</Thickness>
  <Thickness x:Key="Pad.Card">16</Thickness>
  <Thickness x:Key="Pad.Page">24,16,24,16</Thickness>
  <sys:Double x:Key="Height.Control">32</sys:Double>
  <sys:Double x:Key="Height.Row">32</sys:Double>
  <sys:Double x:Key="Height.RowCompact">26</sys:Double>

  <!-- Focus: a 2 px accent ring outside the element, visible on every surface. -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusVisual.Inset">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" RadiusX="3" RadiusY="3" StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
